# syntax=docker/dockerfile:1
FROM python:3.12.12-slim-bookworm@sha256:593bd06efe90efa80dc4eee3948be7c0fde4134606dd40d8dd8dbcade98e669c
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 HOME=/tmp HF_HOME=/tmp/hf \
    HF_HUB_DISABLE_TELEMETRY=1 HF_HUB_DISABLE_PROGRESS_BARS=1
RUN groupadd -g 10001 app && useradd -u 10001 -g 10001 -M app
WORKDIR /app
COPY requirements-init.txt /app/requirements.txt
RUN python -m pip install --no-cache-dir --require-hashes -r requirements.txt && python -m pip check
COPY scripts/download_model.py /app/download_model.py
USER 10001:10001
ENTRYPOINT ["python", "/app/download_model.py"]
